# Postgres (Neon). Leave empty locally to use an embedded PGlite database in .pglite/
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth client, redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Gmail addresses that get admin access
ADMIN_EMAILS=mzorigt6@gmail.com

# Telegram notifications (@BotFather token, and the owner's chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development only: enables email/password sign-in on /api/auth so the app can be
# tested without Google OAuth. Ignored in production builds.
DEV_LOGIN=
